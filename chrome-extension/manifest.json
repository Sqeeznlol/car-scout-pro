{
  "manifest_version": 3,
  "name": "Autosnipe — Mobile.de Manual Worker",
  "version": "3.2.0",
  "description": "Klick auf das Icon öffnet ein Live-Dashboard in einem eigenen Tab. Du siehst in Echtzeit was die Extension gerade tut.",
  "permissions": ["storage", "tabs", "notifications"],
  "host_permissions": [
    "https://*.mobile.de/*",
    "https://autosnipe.shop/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://suchen.mobile.de/fahrzeuge/details.html*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Autosnipe Dashboard öffnen",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
